# Copy this file to .env and fill in real values. .env is gitignored; never commit it.
# Atlas: Database > Connect > Drivers > copy the connection string, put your
# database user's password in it.
MONGODB_URI=
# Optional. Defaults to who-gets-to-code.
MONGODB_DB=who-gets-to-code
# Optional. Any long random string; salts the hashed visitor IDs that the
# submission rate limit keeps for one hour.
RATE_LIMIT_SALT=
# Required for /admin. At least 12 characters. Never put it in code; set it in
# Vercel project settings too. Changing it signs every admin session out.
ADMIN_PASSWORD=
